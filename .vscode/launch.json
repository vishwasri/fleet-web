{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Next.js: Debug Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "sourceMaps": true
    },
    {
      "name": "Next.js: Build & Start (Prod)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build && npm run start",
      "cwd": "${workspaceFolder}"
    }
  ]
}
